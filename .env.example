# Copy locally only when needed. This file contains no usable credentials.
# Keep your existing .env unchanged during the Step 11 overlay installation.
SENTINELOPS_API_KEY=
SENTINELOPS_COLLECTOR_ID=
SENTINELOPS_COLLECTOR_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
SENTINELOPS_GEMINI_ENABLED=0
SENTINELOPS_AI_TIMEOUT_MS=15000
SENTINELOPS_AI_MAX_ATTEMPTS=2
SENTINELOPS_AI_BUDGET_MS=60000
SENTINELOPS_DB=sentinelops.db
SENTINELOPS_ANALYST_DB=analysts.sqlite
SENTINELOPS_REGISTRY_DB=collector_registry.db
# Same-origin dashboard needs no cross-origin access.
ALLOWED_ORIGINS=
